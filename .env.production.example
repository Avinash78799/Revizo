# =====================================================================
# NEET-PG Production Environment Configuration Template
# Release: v1.0.0-PROD-BASELINE
# =====================================================================

# Deployment Domain & Routing
DOMAIN_NAME=neetpg.pro
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="NEET-PG Medically Reviewed Practice Platform"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL 16 with pgvector)
POSTGRES_USER=neetpg_admin
POSTGRES_PASSWORD=GENERATE_STRONG_RANDOM_POSTGRES_PASSWORD_HERE
POSTGRES_DB=neetpg_prod
# Internal container connection string
DATABASE_URL=postgresql+asyncpg://neetpg_admin:GENERATE_STRONG_RANDOM_POSTGRES_PASSWORD_HERE@postgres:5432/neetpg_prod

# Redis 7 Distributed Cache & Rate Limiter
REDIS_PASSWORD=GENERATE_STRONG_RANDOM_REDIS_PASSWORD_HERE
REDIS_URL=redis://:GENERATE_STRONG_RANDOM_REDIS_PASSWORD_HERE@redis:6379/0

# Security & Cryptography
SECRET_KEY=GENERATE_SECURE_RANDOM_64_CHAR_HEX_SECRET_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 Days

# Medical Governance & Safety Enforcement
ENFORCE_TWO_PERSON_REVIEW=true
ENFORCE_STRICT_PROVENANCE=true
ALLOW_MOCK_AI=false

# Past-Year Questions (PYQ) Invariant Gate (Disabled until authentic official papers are ingested)
ENABLE_PYQ_MODULE=false

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=https://neetpg.pro/api/v1
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=production
