# ==============================================================================
# NEET-PG AI Practice & Medical Content Platform
# Staging & Production Environment Configuration Template (.env.example)
# IMPORTANT: Never commit actual credentials or API keys to version control.
# ==============================================================================

ENVIRONMENT=staging
DEBUG=false

# PostgreSQL Database (pgvector/pgvector:pg16)
POSTGRES_USER=staging_user
POSTGRES_PASSWORD=YOUR_STRONG_STAGING_POSTGRES_PASSWORD
POSTGRES_DB=neetpg_staging
DATABASE_URL=postgresql+asyncpg://staging_user:YOUR_STRONG_STAGING_POSTGRES_PASSWORD@127.0.0.1:5432/neetpg_staging

# Redis (redis:7-alpine)
REDIS_PASSWORD=YOUR_STRONG_STAGING_REDIS_PASSWORD
REDIS_URL=redis://:YOUR_STRONG_STAGING_REDIS_PASSWORD@127.0.0.1:6379/0

# Security & Tokens
SECRET_KEY=YOUR_SECURE_RANDOM_JWT_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Provider API Keys (Leave empty for fail-closed UNCONFIGURED state in staging)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Staging Operational Flags
ALLOW_MOCK_AI=false
ENFORCE_TWO_PERSON_REVIEW=true
ENFORCE_STRICT_PROVENANCE=true
